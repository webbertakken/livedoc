{
  "name": "@livedoc/live",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/next-dev.mjs --port 4002",
    "dev:webpack": "node ../../scripts/next-dev.mjs --port 4002 --webpack",
    "build": "next build && node scripts/compile-hints.mjs out && node scripts/asset-size-gate.mjs out && node ../../scripts/first-load.mjs --check live",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium --project=budget --project=sites",
    "test:e2e:smoke": "playwright test --project=chromium",
    "test:e2e:sites": "playwright test --project=sites",
    "test:e2e:budget": "E2E_BUDGET=1 playwright test --project=budget --no-deps",
    "perf:canvas": "E2E_PERF=1 playwright test --project=perf --reporter=line",
    "test:e2e:account": "E2E_ACCOUNT=1 playwright test --project=account --project=account-budget",
    "test:e2e:armed": "E2E_GUEST_SIG_ENFORCE=1 playwright test --project=armed",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next .next-dev .next-analyze out node_modules .turbo coverage",
    "icons:sheet": "vitest run --config scripts/icon-sheet/vitest.config.ts && node scripts/icon-sheet/shoot.mjs",
    "icons:brand": "node scripts/brand-icons/render.mjs",
    "test:e2e:drive": "NEXT_PUBLIC_GOOGLE_CLIENT_ID=123456789012-e2e.apps.googleusercontent.com NEXT_PUBLIC_GOOGLE_API_KEY=e2e-picker-key next build && E2E_DRIVE=1 playwright test --project=drive",
    "test:e2e:drive-shots": "NEXT_PUBLIC_GOOGLE_CLIENT_ID=123456789012-e2e.apps.googleusercontent.com NEXT_PUBLIC_GOOGLE_API_KEY=e2e-picker-key next build && E2E_DRIVE=1 playwright test --project=drive-shots",
    "test:e2e:workbench": "E2E_WORKBENCH=1 playwright test --project=workbench",
    "test:e2e:office": "playwright test --project=office",
    "fonts:document": "node --import ../../scripts/ts-source-hooks.mjs scripts/document-fonts-css.ts",
    "fonts:advances": "node --import ../../scripts/ts-source-hooks.mjs scripts/sheet-font-advances.ts",
    "fonts:system": "node --import ../../scripts/ts-source-hooks.mjs scripts/sheet-system-font-check.ts",
    "fonts:google": "node --import ../../scripts/ts-source-hooks.mjs scripts/google-fonts-catalogue.ts",
    "chars:emoji": "node --import ../../scripts/ts-source-hooks.mjs scripts/emoji-catalogue.ts",
    "chars:special": "node --import ../../scripts/ts-source-hooks.mjs scripts/special-characters-catalogue.ts"
  },
  "dependencies": {
    "@fontsource/amatic-sc": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/caladea": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/comfortaa": "^5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/cousine": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/gelasio": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/lobster": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fontsource/roboto-serif": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@fontsource/stix-two-math": "^5.3.0",
    "@fontsource/tinos": "^5.3.0",
    "@huggingface/transformers": "^3.8.1",
    "@jsquash/webp": "1.5.0",
    "@livedoc/account-session": "workspace:*",
    "@livedoc/api-schema": "workspace:*",
    "@livedoc/document": "workspace:*",
    "@livedoc/document-views": "workspace:*",
    "@livedoc/explorer-lens": "workspace:*",
    "@livedoc/forms": "workspace:*",
    "@livedoc/help-registry": "workspace:*",
    "@livedoc/icons": "workspace:*",
