    "@livedoc/office-packages": "workspace:*",
    "@livedoc/pdf-documents": "workspace:*",
    "@livedoc/plan-art": "workspace:*",
    "@livedoc/sheets": "workspace:*",
    "@livedoc/sticky-model": "workspace:*",
    "@livedoc/sticky-vision": "workspace:*",
    "@livedoc/storm-reading": "workspace:*",
    "@livedoc/telemetry-client": "workspace:*",
    "@livedoc/template-previews": "workspace:*",
    "@livedoc/templates": "workspace:*",
    "@livedoc/text-documents": "workspace:*",
    "@livedoc/ui": "workspace:*",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "@tensorflow/tfjs-layers": "4.22.0",
    "better-auth": "1.7.27",
    "gifenc": "1.0.3",
    "modern-screenshot": "4.7.0",
    "next": "^16.4.3",
    "polygon-clipping": "0.15.7",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.7",
    "prosemirror-view": "^1.42.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@livedoc/agent-verbs": "workspace:*",
    "@livedoc/api-client": "workspace:*",
    "@livedoc/fake-google": "workspace:*",
    "@livedoc/next-config": "workspace:*",
    "@livedoc/oxlint-config": "workspace:*",
    "@livedoc/source-ast": "workspace:*",
    "@livedoc/tailwind-config": "workspace:*",
    "@livedoc/vitest-config": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^31.0.0",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
