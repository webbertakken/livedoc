{
  "name": "@livedoc/office-packages",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./libreoffice": "./node/libreoffice.ts"
  },
  "scripts": {
