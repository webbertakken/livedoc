{
  "name": "@livedoc/sheets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./files": "./src/files/index.ts"
  },
  "scripts": {
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules .turbo coverage",
    "oracle:libreoffice": "ORACLE_SOURCE=libreoffice vitest run --config vitest.oracle.config.ts",
    "oracle:google": "ORACLE_SOURCE=google vitest run --config vitest.oracle.config.ts",
    "oracle:google:consent": "node oracle/google-consent.ts",
    "validate:files": "vitest run --config vitest.validate.config.ts"
  },
  "dependencies": {
    "@livedoc/office-packages": "workspace:*"
  },
  "devDependencies": {
    "@livedoc/fake-google": "workspace:*",
    "@livedoc/oxlint-config": "workspace:*",
    "@livedoc/vitest-config": "workspace:*",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.5",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
