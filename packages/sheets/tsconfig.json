{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    // Explicit, because TypeScript includes no @types package by default: the catalogue test reads formulas.md.
    "types": ["node"],
    // The oracle's consent script runs under plain Node (`node oracle/google-consent.ts`), its imports named in full.
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "oracle/**/*.ts", "corpus/**/*.ts", "*.config.ts"],
  "exclude": ["node_modules"]
}
