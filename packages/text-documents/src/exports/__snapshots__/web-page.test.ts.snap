</style>
</head>
<body>
<p>Where <math xmlns="http://www.w3.org/1998/Math/MathML"><mrow><mfrac><mrow><mi>a</mi></mrow><mrow><mi>b</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo>+</mo><msubsup><mrow><mi>x</mi></mrow><mrow><mn>1</mn></mrow><mrow><mn>2</mn></mrow></msubsup><mroot><mrow><mi>z</mi></mrow><mrow><mn>3</mn></mrow></mroot><msqrt><mi>y</mi></msqrt><mo>≤</mo><mrow><munderover><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>n</mi></mrow></munderover><mrow><mi>k</mi></mrow></mrow><mrow><msub><mo>∫</mo><mrow><mn>0</mn></mrow></msub><mrow><mi>f</mi></mrow></mrow><mrow><mo fence="true" stretchy="true">(</mo><mi>p</mi><mo fence="true" stretchy="true">]</mo></mrow><mover accent="true"><mrow><mi>v</mi></mrow><mo>→</mo></mover><munder><mrow><mi>lim</mi></mrow><mrow><mi>a</mi><mo>→</mo><mi>b</mi></mrow></munder><mtext>if x</mtext></mrow></math> holds.</p>
<p style="text-align: center"><math xmlns="http://www.w3.org/1998/Math/MathML"><mrow><mi>E</mi><mo>=</mo><mi>m</mi><msup><mrow><mi>c</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow></math></p>
</body>
</html>
"
`;

