.footnotes { border-top: 1px solid #888888; margin-top: 2em; }
</style>
</head>
<body>
<p>Before the table</p>
<table><colgroup><col style="width: 144pt" /><col style="width: 108pt" /><col style="width: 216pt" /></colgroup><thead><tr><th><p><strong>Name</strong></p></th><th><p>Kind</p></th><th><p>Notes</p></th></tr></thead><tbody><tr><td colspan="2" style="background-color: #d9ead3"><p>Across two</p></td><td rowspan="2"><p>Down two</p></td></tr><tr><td><p>Lined</p></td><td><p>Nested, with a note<sup><a href="#fn1" id="fnref1">1</a></sup></p>
<table><colgroup><col style="width: 54pt" /><col style="width: 54pt" /></colgroup><tbody><tr><td><p>n1</p></td><td><p>n2</p></td></tr><tr><td><p>n3</p></td><td><p>n4</p></td></tr></tbody></table>
<p><br /></p></td></tr></tbody></table>
<p>After the table</p>
<section class="footnotes"><ol><li id="fn1"><p>In a cell.</p> <a href="#fnref1">↩</a></li></ol></section>
</body>
</html>
"
`;

