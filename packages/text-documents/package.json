{
  "name": "@livedoc/text-documents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing/page-starts": "./src/testing/page-start-fixtures.ts"
  },
  "scripts": {
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules .turbo coverage",
    "validate:files": "vitest run --config vitest.validate.config.ts",
    "gen:preview-advances": "node --import ../../scripts/ts-source-hooks.mjs scripts/gen-preview-advances.ts"
  },
  "dependencies": {
    "@livedoc/api-schema": "workspace:*",
    "@livedoc/document": "workspace:*",
    "@livedoc/live-updates": "workspace:*",
    "@livedoc/office-packages": "workspace:*",
    "parse5": "^8.1.1",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@livedoc/oxlint-config": "workspace:*",
    "@livedoc/pdf-documents": "workspace:*",
    "@livedoc/vitest-config": "workspace:*",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.5",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
