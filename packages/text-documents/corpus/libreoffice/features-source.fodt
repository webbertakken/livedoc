<text:p text:style-name="Title">Features corpus</text:p>
<text:p text:style-name="P1">Centred, with <text:span text:style-name="T1">bold underline</text:span>, <text:span text:style-name="Emphasis">emphasis</text:span>, E=mc<text:span text:style-name="T2">2</text:span> and a <text:bookmark text:name="here"/>bookmark.</text:p>
<text:h text:style-name="Heading_20_1" text:outline-level="1">Heading one</text:h>
<text:p text:style-name="Standard">A footnote<text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p text:style-name="Standard">The note.</text:p></text:note-body></text:note> and a comment<office:annotation office:name="c1"><dc:creator>Ada</dc:creator><dc:date>2026-11-18T10:00:00</dc:date><text:p>Looks good.</text:p></office:annotation> here<office:annotation-end office:name="c1"/>.</text:p>
<text:list xml:id="list1" text:style-name="Numbering_20_123"><text:list-item><text:p text:style-name="Standard">Step one</text:p><text:list><text:list-item><text:p text:style-name="Standard">Step one point one</text:p></text:list-item></text:list></text:list-item><text:list-item><text:p text:style-name="Standard">Step two</text:p><text:p text:style-name="Standard">Step two, second paragraph</text:p></text:list-item></text:list>
<text:p text:style-name="Standard">Between lists, a link to <text:a xlink:type="simple" xlink:href="#here">the bookmark</text:a> and <text:a xlink:type="simple" xlink:href="javascript:alert(1)">a bad link</text:a>.</text:p>
